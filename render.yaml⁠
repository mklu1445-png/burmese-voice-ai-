services:
  - type: web
    name: burmese-voice-ai
    env: node
    plan: free
    buildCommand: npm install
    startCommand: node web/server.js
    envVars:
      - key: NODE_ENV
        value: production
      - key: GEMINI_API_KEY
        sync: false
      - key: GOOGLE_TTS_API_KEY
        sync: false
