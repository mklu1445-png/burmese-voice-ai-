// ==========================================
// 2. BURMESE TEXT SPLITTER (CHUNKER)
// ==========================================
function splitBurmeseTextIntoChunks(text, maxChunkSize = 350) {
  if (!text || !text.trim()) return [];
  const cleaned = text.replace(/\r\n/g, '\n').trim();
  if (cleaned.length <= maxChunkSize) return [cleaned];

  const sentences = [];
  let buffer = '';

  for (let i = 0; i < cleaned.length; i++) {
    const ch = cleaned[i];
    buffer += ch;
    if (ch === '။' || ch === '\n' || ch === '?' || ch === '!' || (ch === '၊' && buffer.length > maxChunkSize * 0.75)) {
      sentences.push(buffer.trim());
      buffer = '';
    }
  }
  if (buffer.trim()) sentences.push(buffer.trim());

  const chunks = [];
  let currentChunk = '';

  for (const s of sentences) {
    if (!s) continue;
    if ((currentChunk + ' ' + s).length > maxChunkSize && currentChunk.length > 0) {
      chunks.push(currentChunk.trim());
      currentChunk = s;
    } else {
      currentChunk = currentChunk ? (currentChunk + ' ' + s) : s;
    }
  }
  if (currentChunk.trim()) chunks.push(currentChunk.trim());

  return chunks.length > 0 ? chunks : [cleaned];
}

function estimateBurmeseMetrics(text, speed = 1.0) {
  const syllables = (text.match(/[\u1000-\u1021][\u102B-\u103E]*/g) || []).length;
  const wordCount = Math.max(1, Math.round(syllables * 0.75) || text.split(/\s+/).length);
  const baseSeconds = Math.max(1.5, syllables * 0.28 / Math.max(0.5, speed));
  return {
    syllableCount: syllables,
    wordCount,
    estimatedDurationMs: Math.round(baseSeconds * 1000)
  };
}

// ==========================================
// 3. AUDIO SYNTHESIS ENGINES & FALLBACKS
// ==========================================

function createWavBuffer(samples, sampleRate = 22050) {
  const byteRate = sampleRate * 2;
  const dataSize = samples.length * 2;
  const buffer = Buffer.alloc(44 + dataSize);

  buffer.write('RIFF', 0);
  buffer.writeUInt32LE(36 + dataSize, 4);
  buffer.write('WAVE', 8);
  buffer.write('fmt ', 12);
  buffer.writeUInt32LE(16, 16);
  buffer.writeUInt16LE(1, 20);
  buffer.writeUInt16LE(1, 22);
  buffer.writeUInt32LE(sampleRate, 24);
  buffer.writeUInt32LE(byteRate, 28);
  buffer.writeUInt16LE(2, 32);
  buffer.writeUInt16LE(16, 34);
  buffer.write('data', 36);
  buffer.writeUInt32LE(dataSize, 40);

  for (let i = 0; i < samples.length; i++) {
    const s = Math.max(-1, Math.min(1, samples[i]));
    const val = s < 0 ? s * 0x8000 : s * 0x7FFF;
    buffer.writeInt16LE(Math.floor(val), 44 + i * 2);
  }

  return buffer;
}

function concatenateWavBuffers(wavBuffers, sampleRate = 22050) {
  if (!wavBuffers || wavBuffers.length === 0) return null;
  if (wavBuffers.length === 1) return wavBuffers[0];

  const allSamples = [];
  const silenceSamples = Math.floor(sampleRate * 0.06);

  for (let idx = 0; idx < wavBuffers.length; idx++) {
    const wav = wavBuffers[idx];
    if (wav.length < 44) continue;
    const pcmDataSize = wav.length - 44;
    const numSamples = Math.floor(pcmDataSize / 2);

    for (let i = 0; i < numSamples; i++) {
      const val = wav.readInt16LE(44 + i * 2);
      allSamples.push(val / 32768.0);
    }

    if (idx < wavBuffers.length - 1) {
      for (let s = 0; s < silenceSamples; s++) {
        allSamples.push(0);
      }
    }
  }

  return createWavBuffer(allSamples, sampleRate);
}

// Built-in Acoustic Synthesizer (Zero-dependency guaranteed fallback)
function synthesizeAcousticWav(text, voice, tone, speed = 1.0, pitch = 1.0, emotion = 0.5, energy = 0.6) {
  const sampleRate = 22050;
  const metrics = estimateBurmeseMetrics(text, speed);
  const totalSeconds = metrics.estimatedDurationMs / 1000;
  const totalSamples = Math.floor(totalSeconds * sampleRate);
  const samples = new Float32Array(totalSamples);

  let f0Base = 140;
  if (voice.id === 'burmese_female') f0Base = 225;
  if (voice.id === 'burmese_young_male') f0Base = 165;
  if (voice.id === 'burmese_young_female') f0Base = 250;
  if (voice.id === 'burmese_deep_narrator') f0Base = 95;

  const effectivePitch = f0Base * voice.basePitch * pitch * tone.pitchMod;
  const effectiveEnergy = Math.max(0.2, Math.min(1.0, energy * voice.baseEnergy));

  const syllables = text.match(/[\u1000-\u104F]+/g) || ['မင်္ဂလာပါ'];
  const samplesPerSyllable = Math.floor(totalSamples / Math.max(1, syllables.length));

  let phase = 0;
  let subPhase = 0;

  for (let i = 0; i < totalSamples; i++) {
    const t = i / sampleRate;
    const sylPhase = (i % samplesPerSyllable) / samplesPerSyllable;

    const toneMod = 1.0 + 0.12 * Math.sin(sylPhase * Math.PI) * (1.0 - sylPhase * 0.35) + 0.04 * Math.sin(t * 8.0);
    const currentF0 = effectivePitch * toneMod;

    phase += (2 * Math.PI * currentF0) / sampleRate;
    subPhase += (2 * Math.PI * (currentF0 * 0.5)) / sampleRate;

    const fundamental = Math.sin(phase);
    const harmonic2 = 0.5 * Math.sin(phase * 2);
    const harmonic3 = 0.28 * Math.sin(phase * 3);
    const harmonic4 = 0.15 * Math.sin(phase * 4);
    const subHarmonic = (voice.id === 'burmese_deep_narrator' ? 0.35 : 0.08) * Math.sin(subPhase);

    let wave = fundamental + harmonic2 + harmonic3 + harmonic4 + subHarmonic;

    let env = 1.0;
    if (sylPhase < 0.15) {
      env = sylPhase / 0.15;
    } else if (sylPhase > 0.85) {
      env = (1.0 - sylPhase) / 0.15;
    }

    const noise = (Math.random() * 2 - 1) * (0.04 + emotion * 0.03);
    const sampleVal = (wave * 0.7 + noise) * env * effectiveEnergy;

    samples[i] = Math.max(-0.95, Math.min(0.95, sampleVal));
  }

  return createWavBuffer(samples, sampleRate);
}

// Google Cloud Text-to-Speech Engine
async function synthesizeGoogleTts(text, voice, speed = 1.0, pitch = 1.0) {
  if (!serverConfig.googleTtsApiKey) throw new Error('No Google TTS API Key configured');

  const url = `https://texttospeech.googleapis.com/v1/text:synthesize?key=${serverConfig.googleTtsApiKey}`;
  const response = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      input: { text },
      voice: {
        languageCode: 'my-MM',
        name: voice.googleTtsVoice || 'my-MM-Standard-A'
      },
      audioConfig: {
        audioEncoding: 'LINEAR16',
        speakingRate: Math.max(0.5, Math.min(2.0, speed * voice.baseSpeed)),
        pitch: (pitch - 1.0) * 10.0,
        sampleRateHertz: 24000
      }
    })
  });

  if (!response.ok) {
    const errText = await response.text();
    throw new Error(`Google TTS API returned ${response.status}: ${errText}`);
  }

  const data = await response.json();
  if (!data.audioContent) throw new Error('No audioContent returned from Google TTS');
  return Buffer.from(data.audioContent, 'base64');
}

// Gemini Neural Audio Engine
async function synthesizeGeminiSpeech(text, voice, tone, speed = 1.0, pitch = 1.0) {
  const apiKey = serverConfig.geminiApiKey;
  if (!apiKey) throw new Error('No Gemini API Key configured');

  const voiceName = voice.geminiVoice || 'Fenrir';
  const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`;

  const prompt = `Read the following Burmese text out loud with a ${tone.nameEn} tone, natural Burmese pronunciation and phrasing:\n\n${text}`;

  const requestBody = {
    contents: [{
      parts: [{ text: prompt }]
    }],
    generationConfig: {
      responseModalities: ['AUDIO', 'TEXT'],
      speechConfig: {
        voiceConfig: {
          prebuiltVoiceConfig: {
            voiceName: voiceName
          }
        }
      }
    }
  };

  const response = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(requestBody)
  });

  if (!response.ok) {
    const errText = await response.text();
    throw new Error(`Gemini Audio API returned ${response.status}: ${errText}`);
  }

  const data = await response.json();
  const candidate = data.candidates?.[0];
  const parts = candidate?.content?.parts || [];

  for (const part of parts) {
    if (part.inlineData && part.inlineData.mimeType?.startsWith('audio/')) {
      return Buffer.from(part.inlineData.data, 'base64');
    }
  }

  throw new Error('No audio part in Gemini response');
}

// Main Synthesis Function per single chunk
async function synthesizeSingleChunk(chunkText, voice, tone, speed, pitch, emotion, energy) {
  if (serverConfig.geminiApiKey) {
    try {
      const audioBuffer = await synthesizeGeminiSpeech(chunkText, voice, tone, speed, pitch);
      if (audioBuffer && audioBuffer.length > 100) return audioBuffer;
    } catch (e) {
      console.warn(`[Synthesis] Gemini Audio failed for chunk, falling back:`, e.message);
    }
  }

  if (serverConfig.googleTtsApiKey) {
    try {
      const audioBuffer = await synthesizeGoogleTts(chunkText, voice, speed, pitch);
      if (audioBuffer && audioBuffer.length > 100) return audioBuffer;
    } catch (e) {
      console.warn(`[Synthesis] Google Cloud TTS failed for chunk, falling back:`, e.message);
    }
  }

  return synthesizeAcousticWav(chunkText, voice, tone, speed, pitch, emotion, energy);
}

