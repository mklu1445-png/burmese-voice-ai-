    const voice = BURMESE_VOICES[voiceId] || BURMESE_VOICES.burmese_male;
    const tone = VOICE_TONES.natural;

    const wavBuf = await synthesizeSingleChunk(voice.sampleText, voice, tone, 1.0, 1.0, 0.5, 0.7);

    res.json({
      success: true,
      audioBase64: wavBuf.toString('base64'),
      mimeType: 'audio/wav',
      voiceId: voice.id,
      sampleText: voice.sampleText
    });
  } catch (error) {
    console.error('[API /api/preview-voice Error]:', error);
    res.status(500).json({ error: error.message || 'Preview generation failed' });
  }
});

app.get('/api/settings', (req, res) => {
  const maskKey = (k) => (k ? `${k.substring(0, 6)}...${k.substring(k.length - 4)}` : '(Not configured)');
  res.json({
    geminiConfigured: !!serverConfig.geminiApiKey,
    geminiKeyMasked: maskKey(serverConfig.geminiApiKey),
    googleTtsConfigured: !!serverConfig.googleTtsApiKey,
    googleTtsKeyMasked: maskKey(serverConfig.googleTtsApiKey),
    activeEngine: serverConfig.activeEngine,
    voices: Object.values(BURMESE_VOICES).map(v => ({ id: v.id, nameEn: v.nameEn, nameMm: v.nameMm, tagMm: v.tagMm })),
    tones: Object.values(VOICE_TONES).map(t => ({ id: t.id, nameEn: t.nameEn, nameMm: t.nameMm }))
  });
});

app.post('/api/settings', (req, res) => {
  try {
    const { geminiApiKey, googleTtsApiKey, activeEngine } = req.body;
    if (typeof geminiApiKey === 'string') serverConfig.geminiApiKey = geminiApiKey.trim();
    if (typeof googleTtsApiKey === 'string') serverConfig.googleTtsApiKey = googleTtsApiKey.trim();
    if (activeEngine) serverConfig.activeEngine = activeEngine;

    res.json({ success: true, message: 'Server settings updated securely.' });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

app.get('/api/health', (req, res) => {
  res.json({ status: 'ok', time: new Date().toISOString(), pwa: true });
});

app.get('*', (req, res) => {
  res.sendFile(path.join(publicPath, 'index.html'));
});

app.listen(PORT, '0.0.0.0', () => {
  console.log(`[Burmese Voice AI] Production PWA & Backend Server running on http://0.0.0.0:${PORT}`);
});
