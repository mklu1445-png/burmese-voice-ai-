app.post('/api/generate-voice', async (req, res) => {
  try {
    const {
      text,
      voiceId = 'burmese_male',
      toneId = 'natural',
      speed = 1.0,
      pitch = 1.0,
      emotion = 0.5,
      energy = 0.6
    } = req.body;

    if (!text || !text.trim()) {
      return res.status(400).json({ error: 'Burmese text is required (စာသား ထည့်သွင်းပေးပါ)' });
    }

    const voice = BURMESE_VOICES[voiceId] || BURMESE_VOICES.burmese_male;
    const tone = VOICE_TONES[toneId] || VOICE_TONES.natural;

    const chunks = splitBurmeseTextIntoChunks(text, 350);
    const totalParts = chunks.length;

    console.log(`[Generate] Processing ${text.length} chars into ${totalParts} chunks.`);

    const chunkBuffers = [];
    for (let i = 0; i < chunks.length; i++) {
      const chunkText = chunks[i];
      const wavBuf = await synthesizeSingleChunk(chunkText, voice, tone, speed, pitch, emotion, energy);
      if (wavBuf) chunkBuffers.push(wavBuf);
    }

    const mergedWav = concatenateWavBuffers(chunkBuffers);
    if (!mergedWav) {
      return res.status(500).json({ error: 'Audio synthesis failed to produce audio data.' });
    }

    const metrics = estimateBurmeseMetrics(text, speed);

    res.json({
      success: true,
      audioBase64: mergedWav.toString('base64'),
      mimeType: 'audio/wav',
      durationMs: metrics.estimatedDurationMs,
      wordCount: metrics.wordCount,
      syllableCount: metrics.syllableCount,
      partsCount: totalParts,
      voiceName: voice.nameMm,
      toneName: tone.nameMm,
      voiceId: voice.id
    });
  } catch (error) {
    console.error('[API /api/generate-voice Error]:', error);
    res.status(500).json({ error: error.message || 'Internal Server Error during voice generation.' });
  }
});

